# Copy this file to .env and fill in your values.
# .env is never committed to git.

PORT=3001

# Option 1: run without any AI key. A simple built-in reader stands in for the AI.
MOCK_LLM=true

# Option 2: use the real AI. Set MOCK_LLM=false (or remove it) and add your key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
